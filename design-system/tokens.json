{
  "version": "0.1.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "safe": {
    "top": 200,
    "bottom": 440,
    "left": 64,
    "right": 150
  },
  "font": {
    "family": "Inter",
    "file": "fonts/Inter-latin-wght-normal.woff2",
    "fallback": "ui-sans-serif, system-ui, sans-serif"
  },
  "color": {
    "text": "#FFFFFF",
    "textMuted": "#D8D8DE",
    "emphasis": "#F2C879",
    "scrim": "rgba(0,0,0,0.38)",
    "cardBg": "rgba(14,14,18,0.80)",
    "cardBorder": "rgba(255,255,255,0.14)",
    "accent": "#F2C879"
  },
  "captions": {
    "size": 66,
    "weight": 700,
    "emphasisWeight": 800,
    "emphasisScale": 1.08,
    "lineHeight": 1.16,
    "letterSpacing": "-0.01em",
    "maxWidth": 850,
    "maxWordsPerGroup": 6,
    "maxGroupSeconds": 2.6,
    "minGroupSeconds": 0.5,
    "pauseBreakSeconds": 0.45,
    "leadInSeconds": 0.06,
    "lingerSeconds": 0.25,
    "shadow": "0 2px 18px rgba(0,0,0,0.55)",
    "entrance": "fade-slide-up",
    "exit": "fade",
    "floorScrim": 0.42
  },
  "verseCard": {
    "referenceSize": 40,
    "textSize": 54,
    "labelSize": 30,
    "weight": 600,
    "maxWidth": 860,
    "padding": 48,
    "radius": 28,
    "entrance": "fade-blur-slide-up",
    "holdMinSeconds": 3.0,
    "dim": 0.4,
    "placement": "center"
  },
  "callout": {
    "size": 88,
    "weight": 800,
    "maxWidth": 880,
    "entrance": "fade-blur-slide-down",
    "holdMinSeconds": 1.6,
    "placement": "upper"
  },
  "contrast": {
    "labelSize": 40,
    "termSize": 84,
    "weight": 800,
    "maxWidth": 900,
    "entrance": "fade-slide-up",
    "holdMinSeconds": 2.4,
    "placement": "center",
    "dim": 0.3
  },
  "motion": {
    "ease": {
      "in": "power2.in",
      "out": "power3.out",
      "inOut": "power2.inOut"
    },
    "entrances": {
      "fade-slide-up": {
        "y": 28,
        "duration": 0.42,
        "blur": 0
      },
      "fade-slide-down": {
        "y": -28,
        "duration": 0.42,
        "blur": 0
      },
      "fade-blur": {
        "y": 0,
        "duration": 0.55,
        "blur": 18
      },
      "fade-blur-slide-up": {
        "y": 24,
        "duration": 0.6,
        "blur": 18
      },
      "fade-blur-slide-down": {
        "y": -24,
        "duration": 0.6,
        "blur": 18
      }
    },
    "exitSeconds": 0.22,
    "punch": {
      "scale": 1.09,
      "inSeconds": 0.38,
      "outSeconds": 0.5,
      "minGapSeconds": 6
    }
  },
  "edit": {
    "maxPauseSeconds": 0.5,
    "reflectivePauseSeconds": 0.9,
    "minShotSeconds": 1.6,
    "jlOffsetSeconds": 0.2,
    "endHoldSeconds": 0.4,
    "startOnSpeech": true
  },
  "banned": [
    "strobe",
    "flicker",
    "shake",
    "glow-burst",
    "lens-flare",
    "chromatic-glitch"
  ]
}
